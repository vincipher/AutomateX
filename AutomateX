#!/bin/bash

# Show banner
clear
source ./resources/banner.sh

while true; do
  echo "=============== Menu ================"
  echo " 1] aboutme - Displays system info "
  echo " 2] changemac - Changes MAC address "
  echo " 3] privacy - Turns off cam and mic "
  echo " 4] noprivacy - Turns on cam and mic "
  echo " 5] update - update your distro "
  echo " 6] pkgloader - auto install packages"
  echo " 7] sysbroom - distro maintenance"
  echo " 0] goodbye - Exit "
  echo "======================================"
  read -p "Select an option >> " choice

  case $choice in
  1)
    clear
    ./aboutme
    echo ""
    read -p "Press Enter to return to the menu..." pause
    clear
    ;;
  2)
    clear
    ./changemac
    echo ""
    read -p "Press Enter to return to the menu..." pause
    clear
    ;;
  3)
    clear
    ./privacy
    echo ""
    read -p "Press Enter to return to the menu..." pause
    clear
    ;;
  4)
    clear
    ./noprivacy
    echo ""
    read -p "Press Enter to return to the menu..." pause
    clear
    ;;
  5)
    clear
    ./update
    echo ""
    read -p "Press Enter to return to the menu..." pause
    clear
    ;;
  6)
    clear
    ./pkgloader
    echo""
    read -p "Press Enter to return to the menu..." pause
    clear
    ;;
  7)
    clear
    ./sysbroom
    echo""
    read -p "Press Enter to return to the menu..." pause
    clear
    ;;
  0)
    clear
    source ./resources/banner.sh
    echo "GOOD"
    echo "BYE!"
    exit 0
    ;;
  *)
    echo "Invalid option, try again."
    read -p "Press Enter to return to the menu..." pause
    clear
    source ./resources/banner.sh
    ;;
  esac
done
