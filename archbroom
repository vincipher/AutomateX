#!/bin/bash

# Colors
GREEN="\e[32m"
YELLOW="\e[33m"
BLUE="\e[34m"
RED="\e[31m"
RESET="\e[0m"
LINE="───────────────────────────────────────────────────────"

echo -e "$LINE"
echo -e "   ${YELLOW}Archbroom System Maintenance – Started${RESET}"
echo -e "$LINE\n"

echo -e " 󰚰  ${BLUE}[Update]${RESET} Checking for system updates..."
yay -Syu --noconfirm
echo -e " 󰩐  ${GREEN}System is up to date!${RESET}\n"

echo -e "   ${BLUE}[Cache]${RESET} Checking pacman cache size..."
pacman_cache_space_used=$(sudo du -sh /var/cache/pacman/pkg 2>/dev/null | awk '{print $1}')
echo -e " 󰃨  ${YELLOW}Pacman cache used:${RESET} $pacman_cache_space_used\n"

echo -e "   ${BLUE}[Cleanup]${RESET} Checking for orphaned packages..."
orphans=$(yay -Qdtq)
if [ -n "$orphans" ]; then
  yay -Rns --noconfirm $orphans
else
  echo -e " 󰔑  ${GREEN}No orphans found.${RESET}"
fi
echo ""

echo -e " 󰩺  ${BLUE}[Cleanup]${RESET} ~/.cache size before clean:"
home_cache_used=$(sudo du -sh ~/.cache | awk '{print $1}')
echo -e " 󰑌  ${YELLOW}~/.cache used:${RESET} $home_cache_used"
rm -rf ~/.cache/yay/* 2>/dev/null
echo -e "   ${GREEN}yay cache cleaned.${RESET}\n"

echo -e " 󱂅  ${BLUE}[Logs]${RESET} Vacuuming system journal (keep 7 days)..."
sudo journalctl --vacuum-time=7d
echo -e " 󰂺  ${GREEN}Journals cleaned.${RESET}\n"

echo -e "   ${GREEN}All tasks complete. Your system is squeaky clean!${RESET}\n"
echo -e "$LINE"
