#!/usr/bin/env bash

set -o pipefail

DRY_RUN=false
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PKG_FILE=""

for arg in "$@"; do
  case "$arg" in
  --dry-run) DRY_RUN=true ;;
  -h | --help)
    echo "Usage: $0 [--dry-run]"
    exit 0
    ;;
  *)
    echo "Unknown argument: $arg" >&2
    exit 2
    ;;
  esac
done

if [[ -f "$SCRIPT_DIR/resources/packages.sh" ]]; then
  PKG_FILE="$SCRIPT_DIR/resources/packages.sh"
elif [[ -f "$SCRIPT_DIR/packages.sh" ]]; then
  PKG_FILE="$SCRIPT_DIR/packages.sh"
else
  echo "Error: packages.sh not found." >&2
  exit 1
fi

# shellcheck source=/dev/null
source "$PKG_FILE" || exit 1

if [[ ! -r /etc/os-release ]]; then
  echo "Cannot detect Linux distribution." >&2
  exit 1
fi

. /etc/os-release
DISTRO="${ID:-unknown}"

case "$DISTRO" in
ubuntu | debian | kali | parrot | linuxmint | pop)
  PKGMGR=apt
  ;;
fedora)
  PKGMGR=dnf
  ;;
arch | manjaro | endeavouros | garuda)
  PKGMGR=pacman
  ;;
*)
  echo "Unsupported distro: $DISTRO" >&2
  exit 1
  ;;
esac

FAILED=0
SKIPPED=0

# Translate package names while keeping packages.sh unchanged.
resolve_package() {
  local pkg="$1"

  case "$DISTRO:$pkg" in
  *:batcat) echo "bat" ;;
  *:brave-bin)
    [[ "$PKGMGR" == pacman ]] && echo "brave-bin" ||
      echo "brave-browser"
    ;;
  *:telegram-desktop) echo "telegram-desktop" ;;
  *:gnome-shell-extension-manager)
    [[ "$PKGMGR" == dnf ]] && echo "gnome-extensions-app" ||
      echo "gnome-shell-extension-manager"
    ;;
  *:gnome-software-plugin-flatpak)
    echo "gnome-software-plugin-flatpak"
    ;;
  *:ssh)
    case "$PKGMGR" in
    apt) echo "openssh-client" ;;
    dnf) echo "openssh-clients" ;;
    pacman) echo "openssh" ;;
    esac
    ;;
  *:proxychains4)
    case "$PKGMGR" in
    apt) echo "proxychains4" ;;
    dnf | pacman) echo "proxychains-ng" ;;
    esac
    ;;
  *:tldr)
    [[ "$PKGMGR" == pacman ]] && echo "tealdeer" ||
      echo "tldr"
    ;;
  *)
    echo "$pkg"
    ;;
  esac
}

is_installed() {
  local pkg="$1"

  case "$PKGMGR" in
  apt)
    dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null |
      grep -qx 'install ok installed'
    ;;
  dnf)
    rpm -q "$pkg" &>/dev/null
    ;;
  pacman)
    pacman -Q "$pkg" &>/dev/null
    ;;
  esac
}

update_system() {
  echo "Updating $DISTRO..."

  if [[ "$DRY_RUN" == true ]]; then
    case "$PKGMGR" in
    apt) echo "[DRY RUN] sudo apt update && sudo apt upgrade -y" ;;
    dnf) echo "[DRY RUN] sudo dnf upgrade --refresh -y" ;;
    pacman) echo "[DRY RUN] sudo pacman -Syu" ;;
    esac
    return 0
  fi

  case "$PKGMGR" in
  apt)
    sudo apt update && sudo apt upgrade -y
    ;;
  dnf)
    sudo dnf upgrade --refresh -y
    ;;
  pacman)
    sudo pacman -Syu --noconfirm
    ;;
  esac
}

install_packages() {
  local group="$1"
  shift
  local packages=("$@")
  local pkg resolved confirm

  ((${#packages[@]})) || return 0

  echo
  echo "=== $group ==="

  read -r -p "Install this group? (y/n): " confirm || return 0
  [[ "${confirm,,}" == y ]] || return 0

  for pkg in "${packages[@]}"; do
    [[ -n "$pkg" ]] || continue

    resolved="$(resolve_package "$pkg")"

    if is_installed "$resolved"; then
      echo "[OK] $pkg is already installed."
      continue
    fi

    if [[ "$DRY_RUN" == true ]]; then
      echo "[DRY RUN] $pkg -> $resolved"
      continue
    fi

    echo "Installing $pkg ($resolved)..."

    case "$PKGMGR" in
    apt)
      sudo apt install -y "$resolved"
      ;;
    dnf)
      sudo dnf install -y "$resolved"
      ;;
    pacman)
      if [[ "$group" == "Extra Apps" ]] &&
        command -v yay &>/dev/null; then
        yay -S --needed --noconfirm "$resolved"
      else
        sudo pacman -S --needed --noconfirm "$resolved"
      fi
      ;;
    esac

    if [[ $? -ne 0 ]]; then
      echo "[FAILED] $pkg ($resolved)"
      FAILED=$((FAILED + 1))
    fi
  done
}

echo "Distro: $DISTRO | Manager: $PKGMGR"

if ! update_system; then
  echo "System update failed; stopping."
  exit 1
fi

if [[ "$PKGMGR" == apt ]] &&
  declare -p DEB_EXTRA &>/dev/null; then
  TERMINAL_TOOLS+=("${DEB_EXTRA[@]}")
fi

install_packages "Terminal Tools" "${TERMINAL_TOOLS[@]}"
install_packages "GNOME Apps" "${GNOME_APPS[@]}"
install_packages "Programming Languages" "${DEV_LANGS[@]}"
install_packages "Optional Packages" "${OPTIONAL_PACKAGES[@]}"
install_packages "Hacking Tools" "${HACKING_TOOLS[@]}"

# Keep your existing YAY_PACKAGES array.
# On non-Arch distributions, try the native package manager.
if declare -p YAY_PACKAGES &>/dev/null; then
  install_packages "Extra Apps" "${YAY_PACKAGES[@]}"
fi

echo
echo "=============================="
echo "Failed packages: $FAILED"
echo "=============================="

if ((FAILED > 0)); then
  exit 1
fi

echo "All requested package installations completed."
